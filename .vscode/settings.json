{
    // 禁用 HTML 文件中 JavaScript 的类型检查和验证
    "js/ts.implicitProjectConfig.checkJs": false,
    "javascript.validate.enable": false,
    
    // 为 HTML 文件禁用所有 JavaScript 诊断
    "[html]": {
        "javascript.validate.enable": false,
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    
    // 为 Jinja HTML 模板禁用验证
    "[jinja-html]": {
        "javascript.validate.enable": false
    },
    
    // 排除 templates 文件夹的 JS/TS 检查
    "javascript.validate.excludePaths": [
        "**/templates/**"
    ],
    "typescript.validate.excludePaths": [
        "**/templates/**"
    ]
}
